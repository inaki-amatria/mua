function foo(a, b, c)
  if a then
    return 1
  elseif b then
    return 2
  else
    return 3
  end
end

-- RUN: %muac -emit=llvm %s 2>&1 | FileCheck %s

-- CHECK-NOT:if.end

--       CHECK:; ModuleID = 'mua module'
--  CHECK-NEXT:source_filename = "{{.*}}lower09.mua"
-- CHECK-EMPTY:
