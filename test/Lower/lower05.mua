--  CHECK-NEXT:  %baz = alloca double, align 8
--  CHECK-NEXT:  store double %1, ptr %baz, align 8
--  CHECK-NEXT:  %bar1 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %3 = fcmp one double %bar1, 0.000000e+00
