--  CHECK-NEXT:  %baz2 = load double, ptr %baz, align 8
--  CHECK-NEXT:  br label %and.end
-- CHECK-EMPTY:
--  CHECK-NEXT:and.end:                                          ; preds = %and.rhs, %2
--  CHECK-NEXT:  %5 = phi double [ %bar1, %2 ], [ %baz2, %and.rhs ]
--  CHECK-NEXT:  %6 = fcmp one double %5, 0.000000e+00
--  CHECK-NEXT:  br i1 %6, label %if.then, label %if.end
-- CHECK-EMPTY:
--  CHECK-NEXT:if.then3:                                         ; preds = %or.end
--  CHECK-NEXT:  ret double 2.000000e+00
-- CHECK-EMPTY:
--  CHECK-NEXT:if.end4:                                          ; preds = %or.end
--  CHECK-NEXT:  ret double 0.000000e+00
-- CHECK-EMPTY:
--  CHECK-NEXT:or.rhs:                                           ; preds = %if.end
--  CHECK-NEXT:  %baz6 = load double, ptr %baz, align 8
--  CHECK-NEXT:  br label %or.end
-- CHECK-EMPTY:
--  CHECK-NEXT:or.end:                                           ; preds = %or.rhs, %if.end
--  CHECK-NEXT:  %7 = phi double [ %bar5, %if.end ], [ %baz6, %or.rhs ]
--  CHECK-NEXT:  %8 = fcmp one double %7, 0.000000e+00
--  CHECK-NEXT:  br i1 %8, label %if.then3, label %if.end4
