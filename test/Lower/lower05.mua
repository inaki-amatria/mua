--  CHECK-NEXT:  %baz = alloca double, align 8
--  CHECK-NEXT:  store double %1, ptr %baz, align 8
--  CHECK-NEXT:  %bar1 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %3 = fcmp one double %bar1, 0.000000e+00
--  CHECK-NEXT:  br i1 %3, label %and.rhs, label %and.end
-- CHECK-EMPTY:
--  CHECK-NEXT:if.then:                                          ; preds = %and.end
--  CHECK-NEXT:  ret double 1.000000e+00
-- CHECK-EMPTY:
--  CHECK-NEXT:if.end:                                           ; preds = %and.end
--  CHECK-NEXT:  %bar5 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %4 = fcmp one double %bar5, 0.000000e+00
--  CHECK-NEXT:  br i1 %4, label %or.end, label %or.rhs
-- CHECK-EMPTY:
