--  CHECK-NEXT:  %4 = select i1 %3, double 1.000000e+00, double 0.000000e+00
--  CHECK-NEXT:  store double %4, ptr %qux, align 8
--  CHECK-NEXT:  %bar3 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %baz4 = load double, ptr %baz, align 8
--  CHECK-NEXT:  %5 = fcmp one double %bar3, %baz4
