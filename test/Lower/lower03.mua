--  CHECK-NEXT:  store double %6, ptr %qux, align 8
--  CHECK-NEXT:  %bar5 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %baz6 = load double, ptr %baz, align 8
--  CHECK-NEXT:  %7 = fcmp olt double %bar5, %baz6
--  CHECK-NEXT:  %8 = select i1 %7, double 1.000000e+00, double 0.000000e+00
--  CHECK-NEXT:  store double %8, ptr %qux, align 8
--  CHECK-NEXT:  %bar7 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %baz8 = load double, ptr %baz, align 8
--  CHECK-NEXT:  %9 = fcmp ogt double %bar7, %baz8
--  CHECK-NEXT:  %10 = select i1 %9, double 1.000000e+00, double 0.000000e+00
--  CHECK-NEXT:  store double %10, ptr %qux, align 8
--  CHECK-NEXT:  %bar9 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %baz10 = load double, ptr %baz, align 8
--  CHECK-NEXT:  %11 = fcmp oge double %bar9, %baz10
--  CHECK-NEXT:  %12 = select i1 %11, double 1.000000e+00, double 0.000000e+00
