--  CHECK-NEXT:  %baz = alloca double, align 8
--  CHECK-NEXT:  %bar1 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %1 = fcmp one double %bar1, 0.000000e+00
--  CHECK-NEXT:  br i1 %1, label %if.then, label %if.else
-- CHECK-EMPTY:
--  CHECK-NEXT:if.then:                                          ; preds = %0
--  CHECK-NEXT:  store double 4.200000e+01, ptr %baz, align 8
--  CHECK-NEXT:  br label %if.end
-- CHECK-EMPTY:
--  CHECK-NEXT:if.else:                                          ; preds = %0
--  CHECK-NEXT:  store double 1.700000e+01, ptr %baz, align 8
--  CHECK-NEXT:  br label %if.end
-- CHECK-EMPTY:
--  CHECK-NEXT:if.end:                                           ; preds = %if.else, %if.then
