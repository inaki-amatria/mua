--  CHECK-NEXT:define double @foo() {
--  CHECK-NEXT:  %bar = alloca double, align 8
--  CHECK-NEXT:  %baz = alloca double, align 8
--  CHECK-NEXT:  %bar1 = load double, ptr %bar, align 8
--  CHECK-NEXT:  %1 = fcmp one double %bar1, 0.000000e+00
--  CHECK-NEXT:  br i1 %1, label %if.then, label %if.end
-- CHECK-EMPTY:
--  CHECK-NEXT:if.then:                                          ; preds = %0
--  CHECK-NEXT:  %baz4 = load double, ptr %baz, align 8
--  CHECK-NEXT:  %2 = fcmp one double %baz4, 0.000000e+00
--  CHECK-NEXT:  br i1 %2, label %if.then2, label %if.end3
-- CHECK-EMPTY:
--  CHECK-NEXT:if.end:                                           ; preds = %if.end3, %0
--  CHECK-NEXT:  ret double 4.200000e+01
-- CHECK-EMPTY:
--  CHECK-NEXT:if.then2:                                         ; preds = %if.then
--  CHECK-NEXT:  ret double 1.700000e+01
-- CHECK-EMPTY:
--  CHECK-NEXT:if.end3:                                          ; preds = %if.then
--  CHECK-NEXT:  br label %if.end
--  CHECK-NEXT:}
