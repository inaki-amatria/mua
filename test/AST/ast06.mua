-- CHECK-NEXT:    ParamDecl baz [{{.*}}ast06.mua:1:19-22]
-- CHECK-NEXT:    CompoundStmt [{{.*}}ast06.mua:2:3-3:4]
-- CHECK-NEXT:      ReturnStmt [{{.*}}ast06.mua:2:3-32]
-- CHECK-NEXT:        BinaryExpr or [{{.*}}ast06.mua:2:10-32]
-- CHECK-NEXT:          BinaryExpr and [{{.*}}ast06.mua:2:10-21]
-- CHECK-NEXT:            IdentifierExpr bar [{{.*}}ast06.mua:2:10-13]
-- CHECK-NEXT:            IdentifierExpr baz [{{.*}}ast06.mua:2:18-21]
-- CHECK-NEXT:          UnaryExpr not [{{.*}}ast06.mua:2:25-32]
-- CHECK-NEXT:            IdentifierExpr bar [{{.*}}ast06.mua:2:29-32]
